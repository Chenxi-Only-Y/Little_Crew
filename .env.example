# ============================================================
# 小剧组 (Little Crew) — 环境变量模板
# 复制为 .env 后填入真实密钥。开发阶段保持 MOCK_* = 1 即可零成本跑通。
# ============================================================

# ---- 大语言模型 (OpenAI 兼容协议，可切换提供者) ----
LLM_PROVIDER=deepseek             # deepseek | zhipu | openai | ollama | custom
DEEPSEEK_API_KEY=                 # 默认密钥（LLM_API_KEY 优先）
LLM_API_KEY=                      # 覆盖密钥
LLM_BASE_URL=                     # 覆盖预设地址
LLM_MODEL=                        # 覆盖预设模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 图像生成 (阿里百炼 / Replicate) ----
DASHSCOPE_API_KEY=
IMAGE_API_KEY=
IMAGE_PROVIDER=dashscope          # dashscope(通义/z-image) | replicate
IMAGE_MODEL=z-image-turbo
IMAGE_BASE_URL=
REPLICATE_API_TOKEN=

# ---- 本地推理服务（零成本测试，部署于 D:\AI\local-gen）----
# 把 IMAGE_PROVIDER / VIDEO_PROVIDER 设为 local，即改走本机 GPU 推理，不再产生 API 费用。
# 服务启动方式、显存策略与限制见 D:\AI\local-gen\README.md
LOCAL_GEN_URL=http://127.0.0.1:8100
LOCAL_IMAGE_STEPS=8            # Z-Image-Turbo 是蒸馏模型，固定 8 步（调高反而劣化画质）
LOCAL_VIDEO_STEPS=50           # MiniMax H3 步数；Disk Offload 下很慢，测试阶段建议 8~15
LOCAL_GEN_TIMEOUT=7200         # 本地视频生成超时（秒）

# ---- 视频生成 (MiniMax H3) ----
VIDEO_PROVIDER=minimax         # minimax | local | ffmpeg
VIDEO_MODEL=MiniMax-H3
VIDEO_MAX_DURATION=7           # 每段时长（秒）。可选档位 5/7/9/12/15，默认 7。
                               # **实际上限由 provider 决定**（见 app/services/providers.py）：
                               #   云端 minimax：5/7/9/12/15
                               #   本地 local  ：仅 5/7/9 —— 8GB 显存超过 10s 必 CUDA OOM，
                               #                且降分辨率无效（瓶颈是 full attention 的序列长度）
                               # 超出上限的取值会被自动向下收敛并记录 warning，不会发出去。
VIDEO_RESOLUTION=768P          # 768P | 2K（1080P 提供者不支持，故不在档位内）
MINIMAX_API_KEY=

# ---- IP-Adapter（角色一致性方案B 参考图生成） ----
IP_ADAPTER_PROVIDER=mock          # replicate | comfyui | mock
IP_ADAPTER_API_KEY=               # 若用 replicate：平台的 API Token
IP_ADAPTER_MODEL=cross-attention  # cross-attention | style（具体取决于所用模型）
IP_ADAPTER_STRENGTH=0.8
# ComfyUI 配置（如果使用本地部署）
COMFYUI_URL=http://localhost:8188
COMFYUI_WORKFLOW=ip_adapter_workflow.json

# ---- 一致性评估配置 ----
CONSISTENCY_THRESHOLD=75           # 一致性评分阈值（0-100），低于此标记偏差/需人工审核
CONSISTENCY_MODEL=clip            # clip | sentence-transformers

# ---- Mock 开关 (1=占位逻辑, 0=调真实 API) ----
MOCK_LLM=1
MOCK_IMAGE=1

# ---- 分镜粒度 (total=全片5-8个镜头, per_scene=按场细分) ----
SHOT_MODE=total

# ---- 人工介入 (1=checkpointer+interrupt 原地暂停/续跑, 0=自动放行) ----
HITL_ENABLED=0

# ---- 生产化：限流 / 配额 / 日志 ----
RATE_LIMIT_PER_MINUTE=10
QUOTA_DAILY_GENERATIONS=5
LOG_LEVEL=INFO

# ---- 视觉质量评估 (1=占位评分, 0=用 CLIP 计算 t2i 相似度) ----
MOCK_QUALITY=1
QUALITY_THRESHOLD=0.5

# ---- 剧评 Agent (1=占位评语, 0=调用 DeepSeek 真实评审) ----
MOCK_CRITICS=1

# ---- 视频合成 (1=占位, 0=FFmpeg 合成+Edge TTS 配音) ----
MOCK_VIDEO=1

# ---- 路径 ----
DB_PATH=./data/little_crew.db
OUTPUT_DIR=./data/outputs
# 数据库连接串：留空用 SQLite(DB_PATH)；填 PostgreSQL 等则切换（如 postgresql://user:pass@host:5432/db）
DB_URL=

# ---- 服务 ----
API_HOST=127.0.0.1
API_PORT=8000
