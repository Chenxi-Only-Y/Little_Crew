[
  {
    "arm": "A 一次 8 场",
    "scenes": [
      {
        "scene_id": "S01",
        "heading": "外景·村口集市·晨",
        "characters": [
          "阿杏",
          "老奶奶",
          "旅人"
        ],
        "text": "腊月集市，阿杏守着干货摊卖干蘑菇。老奶奶凑过来问招工的事。对面墙根蹲着个外乡人，不买也不走。",
        "dialogue": [
          {
            "character": "老奶奶",
            "line": "杏儿，那事儿定下了？"
          },
          {
            "character": "阿杏",
            "line": "定了。初八的车。"
          },
          {
            "character": "老奶奶",
            "line": "你爹知道不？"
          },
          {
            "character": "阿杏",
            "line": "……蘑菇今早新晒的。"
          }
        ]
      },
      {
        "scene_id": "S02",
        "heading": "外景·集市·日",
        "characters": [
          "阿杏",
          "父亲",
          "老奶奶"
        ],
        "text": "父亲一瘸一拐来搬货，腿吃不住劲，仍要自己扛。阿杏伸手去接，被拨开。",
        "dialogue": [
          {
            "character": "父亲",
            "line": "让开。"
          },
          {
            "character": "阿杏",
            "line": "你的腿——"
          },
          {
            "character": "父亲",
            "line": "腿不碍事。嘴碍事。"
          },
          {
            "character": "老奶奶",
            "line": "老李，你这脾气，冻不死的。"
          }
        ]
      },
      {
        "scene_id": "S03",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "半夜父亲咳嗽，咳得炕都响。阿杏端水进去，摸他额头，烫手。",
        "dialogue": [
          {
            "character": "阿杏",
            "line": "烧着呢。"
          },
          {
            "character": "父亲",
            "line": "睡你的去。"
          },
          {
            "character": "阿杏",
            "line": "水放这儿了。"
          },
          {
            "character": "父亲",
            "line": "……嗯。"
          }
        ]
      },
      {
        "scene_id": "S04",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "老奶奶",
          "父亲"
        ],
        "text": "阿杏把老奶奶叫来。老奶奶一看就说这烧压不住，得去镇上。里屋的父亲听见了。",
        "dialogue": [
          {
            "character": "老奶奶",
            "line": "这烧，一宿一宿地往上走。"
          },
          {
            "character": "阿杏",
            "line": "那咋办。"
          },
          {
            "character": "老奶奶",
            "line": "镇上。得找车。"
          },
          {
            "character": "父亲",
            "line": "（里屋）我不去。"
          },
          {
            "character": "老奶奶",
            "line": "（压低声）你爹这脾气，比石头硬。"
          }
        ]
      },
      {
        "scene_id": "S05",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "阿杏翻出包袱要走，父亲以为她提前赶车去城里，火气上来了。碗被掼在炕沿上。",
        "dialogue": [
          {
            "character": "父亲",
            "line": "走你的！初八的车，别误了。"
          },
          {
            "character": "阿杏",
            "line": "我去镇上！给你找车！"
          },
          {
            "character": "父亲",
            "line": "我这腿废了不是一天两天，用不着你可怜。"
          },
          {
            "character": "阿杏",
            "line": "谁可怜你。"
          },
          {
            "character": "父亲",
            "line": "那就走。"
          },
          {
            "character": "阿杏",
            "line": "……你就不能让人省点心。"
          }
        ]
      },
      {
        "scene_id": "S06",
        "heading": "外景·院里·夜",
        "characters": [
          "阿杏",
          "旅人"
        ],
        "text": "阿杏站在院里，风刮得脸疼。旅人在墙根下收拾车绳，看了她一眼。",
        "dialogue": [
          {
            "character": "旅人",
            "line": "车能走。"
          },
          {
            "character": "阿杏",
            "line": "多少钱。"
          },
          {
            "character": "旅人",
            "line": "不要钱。"
          },
          {
            "character": "阿杏",
            "line": "……为啥。"
          },
          {
            "character": "旅人",
            "line": "（把绳子绕好）明早天没亮，我在门口。"
          }
        ]
      },
      {
        "scene_id": "S07",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "阿杏进屋，把包袱解开，衣服一件一件放回柜子里。父亲躺着，眼睛没睁。",
        "dialogue": [
          {
            "character": "阿杏",
            "line": "车明早来。"
          },
          {
            "character": "父亲",
            "line": "……"
          },
          {
            "character": "阿杏",
            "line": "城里的活，我不去了。"
          },
          {
            "character": "父亲",
            "line": "（半晌）随你。"
          },
          {
            "character": "阿杏",
            "line": "嗯。"
          }
        ]
      },
      {
        "scene_id": "S08",
        "heading": "外景·院·晨",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "天还没亮，雪下了一层。阿杏蹲在灶前熬药，父亲披着袄坐在门槛上看着，谁也没提昨晚的事。",
        "dialogue": [
          {
            "character": "父亲",
            "line": "……水开了。"
          },
          {
            "character": "阿杏",
            "line": "知道。"
          },
          {
            "character": "父亲",
            "line": "（把袄往她那边挪了挪）"
          },
          {
            "character": "阿杏",
            "line": "（往灶里添了根柴）"
          }
        ]
      }
    ],
