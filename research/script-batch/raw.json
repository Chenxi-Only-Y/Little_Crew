    "scenes": [
      {
        "scene_id": "S01",
        "heading": "外景·集市·日",
        "characters": [
          "阿杏",
          "父亲",
          "老奶奶",
          "旅人"
        ],
        "text": "腊月集市，雪没化。阿杏守着摊子卖冻梨，父亲拖着伤腿一趟趟搬货，不让她沾手。老奶奶凑过来絮叨，被父亲顶了回去。旅人在摊前停下，买一盒火柴，没多话。",
        "dialogue": [
          {
            "character": "老奶奶",
            "line": "你爹那腿，阴天就犯。"
          },
          {
            "character": "阿杏",
            "line": "嗯。"
          },
          {
            "character": "父亲",
            "line": "别听她唠叨。装车。"
          },
          {
            "character": "老奶奶",
            "line": "你这脾气，早晚……"
          },
          {
            "character": "父亲",
            "line": "冻梨不卖，天黑就烂。"
          },
          {
            "character": "旅人",
            "line": "火柴。"
          },
          {
            "character": "阿杏",
            "line": "两毛。"
          },
          {
            "character": "旅人",
            "line": "……够冷。"
          }
        ]
      },
      {
        "scene_id": "S02",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "父亲半夜咳得坐不起来，烫得厉害。阿杏要去找大夫，父亲硬拦，把炕边的碗扫到地上。",
        "dialogue": [
          {
            "character": "阿杏",
            "line": "爹，起来。"
          },
          {
            "character": "父亲",
            "line": "没事。"
          },
          {
            "character": "阿杏",
            "line": "我去叫大夫。"
          },
          {
            "character": "父亲",
            "line": "不许去。"
          },
          {
            "character": "阿杏",
            "line": "你烧得烫手。"
          },
          {
            "character": "父亲",
            "line": "钱留着。"
          },
          {
            "character": "阿杏",
            "line": "留着干什么。"
          },
          {
            "character": "父亲",
            "line": "……留着。"
          }
        ]
      },
      {
        "scene_id": "S03",
        "heading": "外景·院门口·夜",
        "characters": [
          "阿杏",
          "旅人"
        ],
        "text": "阿杏端着一盆水出来泼，雪地里站着那个旅人，像是在等天亮。她问了一句车，问完就没再开口。屋里父亲喊她，她应了声。",
        "dialogue": [
          {
            "character": "阿杏",
            "line": "往南的车，一天几趟。"
          },
          {
            "character": "旅人",
            "line": "一趟。"
          },
          {
            "character": "阿杏",
            "line": "几点。"
          },
          {
            "character": "旅人",
            "line": "天没亮。"
          },
          {
            "character": "父亲",
            "line": "阿杏——"
          },
          {
            "character": "阿杏",
            "line": "来了。"
          }
        ]
      },
      {
        "scene_id": "S04",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "父亲扶着门框进屋，想要上炕，膝头一软，半跪在灶台边上，还是不肯出声。阿杏过来扶他，他甩了一下手，然后没再甩。",
        "dialogue": [
          {
            "character": "父亲",
            "line": "扶我上炕。"
          },
          {
            "character": "阿杏",
            "line": "爹。"
          },
          {
            "character": "父亲",
            "line": "风大。关门。"
          }
        ]
      },
      {
        "scene_id": "S05",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲",
          "老奶奶",
          "旅人"
        ],
        "text": "老奶奶闻讯过来，摸了摸父亲的手心，转身就要去叫车。父亲撑着说不用，随后提到明天那趟车，说阿杏得走。两个人顶上了。旅人站在门边，没有说话。",
        "dialogue": [
          {
            "character": "老奶奶",
            "line": "手都凉了。"
          },
          {
            "character": "父亲",
            "line": "不碍事。"
          },
          {
            "character": "老奶奶",
            "line": "你这脾气——"
          },
          {
            "character": "父亲",
            "line": "她明天走。"
          },
          {
            "character": "阿杏",
            "line": "我不走。"
          },
          {
            "character": "父亲",
            "line": "你走。"
          }
        ]
      },
      {
        "scene_id": "S06",
        "heading": "内景·外屋·夜",
        "characters": [
          "阿杏",
          "老奶奶",
          "旅人"
        ],
        "text": "父亲喝了水，睡着了。老奶奶出门前把灯芯挑高了一点。旅人从怀里掏出一个纸包，放在灶台上，没有解释来路。",
        "dialogue": [
          {
            "character": "老奶奶",
            "line": "灯别灭了。"
          },
          {
            "character": "旅人",
            "line": "煎三回。"
          },
          {
            "character": "阿杏",
            "line": "……嗯。"
          }
        ]
      },
      {
        "scene_id": "S07",
        "heading": "内景·小屋·夜",
        "characters": [
          "阿杏",
          "父亲"
        ],
        "text": "父亲烧得迷糊，仍逼阿杏收拾东西去镇上投亲；阿杏把包袱按回炕沿，第一次顶了嘴。",
        "dialogue": [
          {
            "character": "父亲",
            "line": "走吧。别守着我。"
          },
          {
            "character": "阿杏",
            "line": "我不走。"
          },
          {
            "character": "父亲",
            "line": "你留下，能干啥？"
          },
          {
            "character": "阿杏",
            "line": "烧水，熬药，开门。"
          }
        ]
      },
      {
        "scene_id": "S08",
        "heading": "外景·院门口·晨",
        "characters": [
          "阿杏",
          "老奶奶",
          "旅人"
        ],
        "text": "天刚亮，阿杏扫开门口积雪，把父亲的旧棉鞋晾在灶台边；老奶奶送来半碗小米，旅人背起包要走。阿杏没解释，只把院门闩上。",
        "dialogue": [
          {
            "character": "老奶奶",
            "line": "你爹咋样？"
          },
          {
            "character": "阿杏",
            "line": "还烧着。"
          },
          {
            "character": "旅人",
            "line": "我走了。"
          },
          {
            "character": "阿杏",
            "line": "路滑。"
          }
        ]
      }
