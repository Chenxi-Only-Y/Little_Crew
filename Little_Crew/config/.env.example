# ============================================================================
#  秘密凭据模板 —— 复制为 .env 后填写真实值
#
#  规则（STRUCTURE.md §2）：
#    · 本文件的键必须与 config/.env 完全一致
#    · .env 绝不入库；本文件必须入库
#    · 只有"保密"的值放这里；其他参数放 config/project.toml
#
#  用法：
#    copy config\.env.example config\.env
# ============================================================================

# ---- 文本大模型（剧本 / 分镜 / 审片）----
# OpenAI 兼容接口即可。留空则该能力不可用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：备用模型（主模型失败时降级）
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- 视觉模型（审片官；跨模型族盲读要求审核方与生成方不同族）----
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# ---- ComfyUI ----
# 留空则跳过本地执行能力（仅做编译与校验）
COMFYUI_ENDPOINT=http://127.0.0.1:8188
COMFYUI_WS_ENDPOINT=ws://127.0.0.1:8188/ws

# ---- 本地生成服务（可选）----
# 若使用 D:\AI\local-gen 这类 HTTP 服务，在此填端点
LOCAL_GEN_ENDPOINT=http://127.0.0.1:8100
LOCAL_GEN_API_KEY=

# ---- 云端生成 API（可选；用于 2K 定稿等本地做不到的能力）----
CLOUD_IMAGE_API_KEY=
CLOUD_VIDEO_API_KEY=

# ---- 存储与数据库 ----
# 默认用项目内的 SQLite，无需填写。切 PostgreSQL 时填 DSN。
DATABASE_URL=

# ---- 部署情形（决定模型授权门禁的判定结果）----
# 见 docs/02-模型调研与适配方案.md §8
DEPLOY_REGION=CN
DEPLOY_COMMERCIAL=false
DEPLOY_ANNUAL_REVENUE_USD=0
